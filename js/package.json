{
  "name": "moq-secure",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:browser": "tsup src/index.ts --format iife --global-name MoqSecure --platform browser --out-dir dist/browser",
    "generate-test-vectors": "tsx ../test-vectors/generate-js-test-vectors.ts",
    "pretest": "npm run generate-test-vectors",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.3.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
